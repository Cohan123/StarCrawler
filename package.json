{
  "name": "starcrawler",
  "description": "Classic roguelike RPG - ASCII sci-fi horror rendered in space stations",
  "author": "Cohan123 <helium03@web.de>",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 3000\" \"wait-on http://localhost:3000 && ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:preview": "vite build && electron .",
    "electron": "electron .",
    "build:electron": "vite build && electron-builder --linux --x64",
    "build:electron:dir": "vite build && electron-builder --linux --x64 --dir",
    "dist": "vite build",
    "pack": "electron-builder --linux --dir"
  },
  "dependencies": {
    "@google/genai": "^1.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.starcrawler.game",
    "productName": "StarCrawler",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "icon": "Bilder/Chraktere/Marine.png"
    },
    "publish": null
  }
}
